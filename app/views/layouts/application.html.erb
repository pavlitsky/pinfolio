<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Pinfolio" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Pinfolio">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <%# Broadcast refreshes morph the page in place, keeping scroll position %>
    <%= turbo_refresh_method_tag :morph %>
    <%= turbo_refresh_scroll_tag :preserve %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <main class="container mx-auto mt-6 px-5 flex">
      <%= yield %>
    </main>

    <%# Image preview: items#show loads into the frame, the modal controller opens the dialog %>
    <dialog id="image_preview" data-turbo-permanent class="m-auto max-h-none max-w-none overflow-visible bg-transparent p-0 backdrop:bg-black/85"
            aria-label="Image preview"
            data-controller="modal"
            data-action="turbo:frame-load->modal#open close->modal#reset click->modal#closeOnBackdrop keydown.left->modal#previous keydown.right->modal#next">
      <%# Dimmed while the next image loads (Turbo sets [busy] on the frame) %>
      <%= turbo_frame_tag "modal", class: "block transition-opacity [&[busy]]:opacity-60", data: { modal_target: "frame" } %>
    </dialog>

    <%# Notifications appended via Turbo Streams, e.g. "Image hidden · Undo" %>
    <div id="toasts" data-turbo-permanent class="pointer-events-none fixed inset-x-0 bottom-4 z-50 flex flex-col items-center gap-2 px-4" aria-live="polite"></div>
  </body>
</html>
