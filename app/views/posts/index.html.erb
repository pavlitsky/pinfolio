<% content_for :title, "Posts" %>
<%# Refreshes when posts are created elsewhere (another tab) %>
<%= turbo_stream_from "posts" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="sticky top-0 z-10 bg-white py-4 mb-4">
    <%# Inset like the post cards' padding, so it lines up with the post titles; above the search on phones %>
    <%= link_to "Pinfolio", root_path,
          class: "block mb-3 px-4 text-3xl font-bold text-gray-700 hover:text-gray-900 sm:absolute sm:inset-y-0 sm:left-5 sm:mb-0 sm:flex sm:items-center sm:px-0" %>
    <%= render "idea_form", post: @post %>
  </div>

  <div id="posts" class="min-w-full space-y-5">
    <%= render partial: "entry", collection: @posts, as: :post %>
    <%# Shown only while the list has no posts; stays last so new posts prepend before it %>
    <p class="hidden only:block text-center my-10">No posts found.</p>
  </div>
</div>
