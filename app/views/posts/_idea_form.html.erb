<%= form_with(model: post, id: "idea_form", data: { turbo_permanent: true }) do |form| %>
  <%= form.text_field :title,
        placeholder: "Search anything...",
        autofocus: true,
        autocomplete: "off",
        "aria-label": "Search anything...",
        class: ["block w-full sm:w-1/2 mx-auto shadow-sm rounded-md border px-4 py-3 text-lg focus:outline-none", { "border-gray-400": post.errors[:title].none?, "border-red-400": post.errors[:title].any? }] %>
  <% post.errors.full_messages_for(:title).each do |message| %>
    <p class="mt-2 text-center text-red-500 text-sm"><%= message %></p>
  <% end %>
<% end %>
