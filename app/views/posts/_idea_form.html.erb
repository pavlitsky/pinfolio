<%# Not data-turbo-permanent: streams replace it to clear it after a create or show errors %>
<%= form_with(model: post, id: "idea_form", data: { controller: "morph-skip", action: "turbo:before-morph-element->morph-skip#skip" }) do |form| %>
  <div class="relative w-full sm:w-1/2 mx-auto">
    <%= form.text_field :title,
          placeholder: "Search anything...",
          autofocus: true,
          autocomplete: "off",
          "aria-label": "Search anything...",
          class: ["block w-full shadow-sm rounded-md border py-3 pl-4 pr-44 text-lg focus:outline-none", { "border-gray-400": post.errors[:title].none?, "border-red-400": post.errors[:title].any? }] %>
    <%# Source switcher, inside the input on the right %>
    <fieldset class="absolute inset-y-0 right-2 flex items-center">
      <legend class="sr-only">Search on</legend>
      <div class="flex rounded-md bg-gray-100 p-0.5 text-sm">
        <% Post.sources.each_key do |source| %>
          <label class="cursor-pointer rounded px-2.5 py-1 text-gray-500 transition-colors hover:text-gray-800 has-checked:bg-white has-checked:text-gray-800 has-checked:shadow-sm has-focus-visible:outline-2 has-focus-visible:outline-gray-500">
            <%= form.radio_button :source, source, class: "sr-only" %>
            <%= Post.source_name(source) %>
          </label>
        <% end %>
      </div>
    </fieldset>
  </div>
  <% post.errors.full_messages_for(:title).each do |message| %>
    <p class="mt-2 text-center text-red-500 text-sm"><%= message %></p>
  <% end %>
<% end %>
