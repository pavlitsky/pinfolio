<div id="<%= dom_id post %>" class="group/post w-full my-5 space-y-3" data-controller="toggle">
  <div class="flex items-center justify-between gap-4">
    <div class="flex items-baseline gap-3 min-w-0">
      <h2 class="font-semibold text-[2.1rem] leading-tight text-gray-500"><%= post.title %></h2>
      <%= render "posts/hidden_count", post: %>
    </div>
    <%= button_to "×", post, method: :delete,
          form_class: "shrink-0",
          class: "flex items-center justify-center size-8 rounded-full text-2xl leading-none text-gray-400 hover:text-red-600 hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-red-600 cursor-pointer transition opacity-0 group-hover/post:opacity-100 focus-visible:opacity-100 [@media(hover:none)]:opacity-100",
          title: "Delete post",
          "aria-label": "Delete post “#{post.title}”" %>
  </div>

  <%# Hidden images, fetched the first time the panel is opened %>
  <div id="<%= dom_id post, :hidden_panel %>" class="rounded-md bg-gray-50 p-3" hidden data-toggle-target="panel">
    <%= turbo_frame_tag dom_id(post, :hidden_items), src: post_hidden_items_path(post), loading: :lazy do %>
      <p class="text-sm text-gray-400">Loading hidden images…</p>
    <% end %>
  </div>

  <%= render "posts/grid", post: %>
</div>
